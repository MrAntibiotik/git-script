# Скопіюйте у .env і заповніть. Файл .env НЕ комітити і нікому не передавати.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Meta (Facebook + Instagram) ---
META_APP_ID=
META_APP_SECRET=
# Заповнюються автоматично командою: python poster.py auth meta
META_PAGE_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
# Необов'язково: окремий токен для Instagram (якщо не задано — використовується META_PAGE_TOKEN)
META_IG_TOKEN=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube: client_secret.json (шлях у config.json), токен — tokens/youtube_token.json
